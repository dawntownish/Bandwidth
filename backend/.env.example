# ---- The model Bandwidth uses: Meta Muse Glimmer (open-weight) ----
# Free key: sign in at https://routeway.ai, create an API key, and paste it after OPEN_API_KEY=
OPEN_API_KEY=
OPEN_API_URL=https://api.routeway.ai/v1/chat/completions
OPEN_MODEL=muse-glimmer-30b:free
# This text appears in the app as "AI-generated by ...". Keep it true to what is actually running.
OPEN_LABEL=Meta Muse Glimmer 30B (open-weight, via Routeway)
# Glimmer can think before it answers. "low" keeps it fast. Delete this line if the host rejects it.
OPEN_REASONING_EFFORT=low

# ---- Optional: hosted Muse Spark through the Meta Model API (leave empty if you don't have it) ----
META_API_KEY=
META_API_URL=https://api.meta.ai/v1/chat/completions
META_MODEL=muse-spark-1.1

# ---- Natural voice for Listen (optional) ----
# Leave TTS_API_URL empty to use your browser's built-in voice (no setup needed).
TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=

PORT=3000
